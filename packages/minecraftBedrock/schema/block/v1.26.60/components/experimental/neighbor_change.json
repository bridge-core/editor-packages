{
    "$schema": "https://json-schema.org/draft-07/schema",
    "title": "Neighbor Change",
    "description": "Configures which neighboring block changes can trigger a block custom component event.",
    "type": "object",
    "properties": {
        "neighbor_directions": {
            "description": "The directions to observe. The all value must be used alone.",
            "type": "array",
            "items": {
                "type": "string",
                "enum": [
                    "all",
                    "up",
                    "down",
                    "north",
                    "south",
                    "west",
                    "east"
                ]
            }
        }
    },
    "additionalProperties": false
}