{
    "$schema": "https://json-schema.org/draft-07/schema",
    "type": "object",
    "properties": {
        "minecraft:server_sound_definitions": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/server_sound_definition"
            }
        }
    },
    "definitions": {
        "server_sound_definition": {
            "type": "object",
            "properties": {
                "sound_event_name": {
                    "type": "string"
                },
                "duration_info": {
                    "type": "object",
                    "properties": {
                        "mode": {
                            "type": "string",
                            "enum": [
                                "game_time",
                                "real_time"
                            ]
                        },
                        "seconds": {
                            "type": "number"
                        }
                    }
                },
                "music_info": {
                    "type": "object",
                    "properties": {
                        "genres": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "moods": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "artist": {
                            "type": "string"
                        },
                        "title": {
                            "type": "string"
                        }
                    }
                },
                "tags": {
                    "type": "object",
                    "additionalProperties": true
                },
                "broadcast_range": {
                    "type": "integer"
                }
            }
        }
    }
}