{
	"$schema": "https://json-schema.org/draft-07/schema",
	"title": "Multipart Block Column Feature",
	"description": "",
	"type": "object",
	"properties": {
		"description": {
			"type": "object",
			"properties": {
				"identifier": {
					"$ref": "../../../project/prefixedFileIdentifierEnum.json"
				}
			}
		},
		"tip_block": {
			"description": "The topmost block of the column.",
			"$ref": "../../general.json#/definitions/block_reference"
		},
		"frustum_block": {
			"description": "The second topmost block below the tip if the column is at least two blocks.",
			"$ref": "../../general.json#/definitions/block_reference"
		},
		"middle_block": {
			"description": "The block that is placed between the base and frustum blocks when the column is at least four blocks.",
			"$ref": "../../general.json#/definitions/block_reference"
		},
		"base_block": {
			"description": "The bottom-most block when the column is at least three blocks.",
			"$ref": "../../general.json#/definitions/block_reference"
		},
		"height_range": {
			"description": "The range of blocks the column can be high.",
			"type": "object",
			"properties": {
				"range_min": {
					"type": "number"
				},
				"range_max": {
					"type": "number"
				}
			}
		},
		// TODO: Verify this in game
		"weighted_heights": {
			"description": "Weighted list of heights.",
			"type": "array",
			"items": {
				"type": "array",
				"items": [
					{
						"type": "integer"
					},
					{
						"type": "number"
					}
				]
			}
		},
		"direction": {
			"description": "The direction of the column.",
			"type": "string",
			"enum": [
				"UP",
				"DOWN"
			]
		},
		"may_place_on": {
			"type": "array",
			"items": {
				"$ref": "../../general.json#/definitions/block_reference"
			}
		},
		"may_replace": {
			"description": "A list of blocks that may be replaced during placement. Omit this field to allow any block to be replaced.",
			"type": "array",
			"items": {
				"$ref": "../../general.json#/definitions/block_reference"
			}
		}
	},
	"additionalProperties": false
}