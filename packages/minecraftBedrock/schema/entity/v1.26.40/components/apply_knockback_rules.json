{
    "$schema": "https://json-schema.org/draft-07/schema",
    "title": "Apply Knockback Rules",
    "type": "object",
    "properties": {
        "presets": {
            "title": "Presets",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "filter": {
                        "title": "Filter",
                        "$ref": "../../general/v1.16.0/filter.json"
                    },
                    "horizontal_power": {
                        "title": "Horizontal Power",
                        "type": "number"
                    },
                    "vertical_power": {
                        "title": "Vertical Power",
                        "type": "number"
                    },
                    "vertical_velocity_cap": {
                        "title": "Vertical Velocity Cap",
                        "type": "number"
                    },
                    "slowdown_scale": {
                        "title": "Slowdown Scale",
                        "type": "number"
                    },
                    "scale_with_damage": {
                        "title": "Scale with Damage",
                        "type": "boolean"
                    },
                    "extra_knockback_approach": {
                        "title": "Extra Knockback Approach",
                        "type": "string",
                        "enum": [
                            "reapply_default",
                            "multiply_reduced"
                        ]
                    },
                    "knockback_mode": {
                        "title": "Knockback Mode",
                        "type": "string",
                        "enum": [
                            "relative_horizontal",
                            "hit_direction"
                        ]
                    },
                    "horizontal_hit_angle_scale": {
                        "doNotSuggest": true,
                        "deprecationMessage": "Deprecated as of v1.26.40"
                    },
                    "vertical_hit_angle_scale": {
                        "doNotSuggest": true,
                        "deprecationMessage": "Deprecated as of v1.26.40"
                    },
                    "vertical_position_angle_scale": {
                        "doNotSuggest": true,
                        "deprecationMessage": "Deprecated as of v1.26.40"
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}